# Used by `yarn updateApisFromEcom`. Copy to `.env` (gitignored) and fill in.
# Git remote URL of the ECOM monorepo: https://<host>/<org>/<repo>.git (your existing git credentials authenticate)
ECOM_REPO_URL=
# Path of the SCAPI OAS source tree inside that repo
ECOM_OAS_ROOT=
# Optional. Overrides the ref derived from api-versions.txt (use master until release.27.1 exists)
ECOM_OAS_REF=
