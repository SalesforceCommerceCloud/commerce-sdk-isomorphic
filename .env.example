# Used by `yarn updateApis`. Copy to `.env` (gitignored) and fill in.
# Git remote URL of the ECOM monorepo: https://<host>/<org>/<repo>.git (your existing git credentials authenticate)
ECOM_REPO_URL=
# Path of the SCAPI bundles directory inside that repo (holds <type>/<family>/<api>/vN/manifest.json)
ECOM_BUNDLES_ROOT=
# Optional. Overrides the release branch derived from api-versions.txt.
# Set to master only while the target release branch (for example release.27.1) has not been
# cut or does not carry the bundles yet; remove it as soon as the branch does, or releases
# silently keep pulling master.
ECOM_OAS_REF=
